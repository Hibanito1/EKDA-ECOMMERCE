# EKDA Ecommerce — Environment Variables
# Copy this file to .env.local and fill in your actual values

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Paystack ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret

# ─── Stripe ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Monnify ─────────────────────────────────────────────────────────────────
MONNIFY_API_KEY=your_monnify_api_key
MONNIFY_CONTRACT_CODE=your_monnify_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# ─── AI / OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
GROQ_API_KEY=gsk_your-groq-api-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EKDA Marketplace

# ─── Email (Resend or SMTP) ───────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ─── SMS (Termii or Twilio) ───────────────────────────────────────────────────
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=EKDA
