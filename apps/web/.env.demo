# EKDA Demo Mode Environment — For Testing Only
# Copy to .env.local to enable demo mode

# ─── Demo Mode Flag ────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (placeholder — demo mode doesn't require real Supabase) ─────────
# For production features, replace with real Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# ─── Payment Gateways (Sandbox/Test Keys) ─────────────────────────────────────
# These are intentionally placeholder — demo mode simulates all payments
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_demo_placeholder
PAYSTACK_SECRET_KEY=sk_test_demo_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_demo_placeholder
STRIPE_SECRET_KEY=sk_test_demo_placeholder

# ─── AI (demo mode uses simulated responses) ──────────────────────────────────
GROQ_API_KEY=demo_placeholder_key
OPENAI_API_KEY=demo_placeholder_key

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=EKDA Marketplace (Demo)
NODE_ENV=development
